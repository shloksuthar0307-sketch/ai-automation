# ==============================================================================
# Sitewright Production & Development Environment Configuration
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Update all placeholder values with your production secrets.
# 3. NEVER commit the actual '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DJANGO SETTINGS
# ------------------------------------------------------------------------------
# Set to False in production. If True, verbose debug pages are displayed.
DJANGO_DEBUG=False

# Cryptographically strong secret key (minimum 50 random characters).
# Generate one using: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-random-50-character-secret-key-in-production

# Custom administrative URL path. In production, this is strictly mandatory.
# Do NOT use 'admin/' in production to prevent automated scanning bots.
# Must include trailing slash (e.g., custom-panel-8832/)
DJANGO_ADMIN_URL=ops-admin-secure-panel/

# Allowed host header values (comma-separated).
# Example: sitewright.in,www.sitewright.in
DJANGO_ALLOWED_HOSTS=sitewright.in,www.sitewright.in,127.0.0.1,localhost

# CSRF Trusted Origins (comma-separated URLs with scheme).
# Required by Django 4+ for secure POST submissions from your domain.
CSRF_TRUSTED_ORIGINS=https://sitewright.in,https://www.sitewright.in


# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Automatic PostgreSQL with SQLite Fallback)
# ------------------------------------------------------------------------------
# Primary database connection string (recommended for PaaS / Docker / Cloud):
DATABASE_URL=postgresql://sitewright_user:super_secure_password_here@localhost:5432/sitewright_prod

# Alternatively, specify individual PostgreSQL parameters:
# POSTGRES_DB=sitewright_prod
# POSTGRES_USER=sitewright_user
# POSTGRES_PASSWORD=super_secure_password_here
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# Connection pooling lifetime (in seconds). Default: 600 (10 minutes).
# SQLite will automatically use 0 to prevent file locks.
DJANGO_DB_CONN_MAX_AGE=600

# Note: If PostgreSQL is not installed, unconfigured, or unreachable,
# Sitewright automatically falls back to local SQLite (db.sqlite3).


# ------------------------------------------------------------------------------
# 3. CACHE & RATE LIMITING (Redis)
# ------------------------------------------------------------------------------
# Production Redis instance for multi-worker shared rate limiting and caching.
# If omitted, LocMemCache is used (single-worker fallback).
REDIS_URL=redis://localhost:6379/0


# ------------------------------------------------------------------------------
# 4. HTTPS, REVERSE PROXY & SECURITY
# ------------------------------------------------------------------------------
# Enforce HTTPS redirects (defaults to True when DJANGO_DEBUG=False).
# Set to False only if SSL termination is handled upstream and proxy headers are not set.
DJANGO_SSL_REDIRECT=True

# Set to True if Django runs behind an SSL-terminating reverse proxy (Nginx, Traefik, AWS ALB, Cloudflare).
# Tells Django to inspect the 'X-Forwarded-Proto: https' header to avoid redirect loops.
USE_PROXY_SSL_HEADER=True

# Number of reverse proxies in front of the application.
# Used by get_client_ip to safely extract real client IP from X-Forwarded-For.
# Example: 1 if behind Nginx or Cloudflare; 2 if Cloudflare -> Nginx -> Django.
TRUSTED_PROXY_COUNT=1


# ------------------------------------------------------------------------------
# 5. STATIC & MEDIA FILE STORAGE
# ------------------------------------------------------------------------------
# Enable AWS S3 for media / static storage (True / False). Default: False (WhiteNoise + Local Disk).
USE_S3_STORAGE=False

# AWS S3 Settings (required if USE_S3_STORAGE=True)
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_STORAGE_BUCKET_NAME=sitewright-assets
# AWS_S3_REGION_NAME=ap-south-1

# WhiteNoise settings
WHITENOISE_MANIFEST_STRICT=False
WHITENOISE_MAX_AGE=31536000


# ------------------------------------------------------------------------------
# 6. EMAIL & LEAD NOTIFICATIONS
# ------------------------------------------------------------------------------
# Email backend: 'django.core.mail.backends.smtp.EmailBackend' in production.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Recipient email address for inbound quote notifications
ADMIN_NOTIFICATION_EMAIL=contact@sitewright.in
DEFAULT_FROM_EMAIL=no-reply@sitewright.in

# SMTP Configuration (if using SMTP backend)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-sendgrid-api-key
# EMAIL_USE_TLS=True


# ------------------------------------------------------------------------------
# 7. BUSINESS & AGENCY PROFILE
# ------------------------------------------------------------------------------
DEVELOPER_NAME=Shlok Suthar
DEVELOPER_CITY=Ahmedabad, India
WHATSAPP_NUMBER=+919876543210
BOOKING_URL=https://cal.com/sitewright/15min
